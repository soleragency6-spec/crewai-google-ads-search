# À définir dans Render → Environment. Ne jamais publier de vraie clé.
OPENAI_API_KEY=
WEBHOOK_TOKEN=
RESEND_API_KEY=

# Le domaine expéditeur doit être vérifié dans Resend.
ALERT_EMAIL_FROM=contact@soler-agency.com
ALERT_EMAIL_TO=contact@soler-agency.com

# Garder true pour les premiers essais ; false pour les ordres automatiques.
DRY_RUN=true

# Facultatif : disque persistant si disponible. Sinon journal local éphémère.
# ALERT_STATE_DB=/var/data/google-ads-alerts.sqlite3
