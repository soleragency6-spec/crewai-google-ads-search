# À définir dans Render → Environment. Ne jamais publier de vraie clé.
OPENAI_API_KEY=
WEBHOOK_TOKEN=
RESEND_API_KEY=
# Génération d'images OpenAI ; gpt-image-2.5-flare est aussi la valeur par défaut.
IMAGE_MODEL=gpt-image-2.5-flare

# WhatsApp Cloud API Meta : ne fonctionne qu'après création du compte,
# enregistrement du numéro et approbation d'un modèle avec {{1}} dans le corps.
# Sans ces paramètres, les demandes de vraies ressources restent bloquées
# et sont relayées vers l'email Resend configuré ci-dessus.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr
WHATSAPP_GRAPH_VERSION=

# Le domaine expéditeur doit être vérifié dans Resend.
ALERT_EMAIL_FROM=contact@soler-agency.com
ALERT_EMAIL_TO=contact@soler-agency.com

# Garder true pour les premiers essais ; false pour les ordres automatiques.
DRY_RUN=true

# Facultatif : disque persistant si disponible. Sinon journal local éphémère.
# ALERT_STATE_DB=/var/data/google-ads-alerts.sqlite3
